# ===================================================
# CONFIGURAÇÃO DE AMBIENTE - BOT SSP
# ===================================================

# Discord Bot Token
DISCORD_TOKEN=seu_discord_bot_token_aqui

# Discord Application / Client ID
DISCORD_CLIENT_ID=seu_client_id_aqui

# Guild ID opcional para registro rápido de comandos em ambiente de desenvolvimento (deixe vazio para registro global)
DISCORD_GUILD_ID=

# Conexão com o Banco de Dados PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/botssp?schema=public"

# Ambiente de Execução (development | production)
NODE_ENV=development

# Nível de Log (debug | info | warn | error)
LOG_LEVEL=info

# Identificador Institucional do Estado / Corporação
INSTITUTION_NAME="SECRETARIA DE SEGURANÇA PÚBLICA"
STATE_NAME="ESTADO DE SÃO PAULO"
